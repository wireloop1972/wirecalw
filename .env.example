# --- Supabase (Nevlunghavn instance) ---
NEVLUNGHAVN_SUPABASE_URL=https://your-project.supabase.co
NEVLUNGHAVN_SUPABASE_ANON_KEY=your-anon-key
NEVLUNGHAVN_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEVLUNGHAVN_SUPABASE_JWT_SECRET=your-jwt-secret

# Public keys (exposed to browser)
NEXT_PUBLIC_NEVLUNGHAVN_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_NEVLUNGHAVN_SUPABASE_ANON_KEY=your-anon-key

# OpenClaw gateway base URL (no trailing slash)
OPENCLAW_BASE_URL=http://167.99.128.115

# OpenClaw gateway bearer token (either variable name works)
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here
# OPENCLAW_API_KEY=your-gateway-token-here

# Poe runtime mode: "openclaw-direct" (default) or "paperclip-proxy"
# POE_RUNTIME_MODE=openclaw-direct

# Paperclip (only needed when POE_RUNTIME_MODE=paperclip-proxy)
# PAPERCLIP_BASE_URL=http://127.0.0.1:3100
# PAPERCLIP_API_KEY=your-paperclip-token-here
# PAPERCLIP_POE_AGENT_ID=24b159a0-493f-4ee8-9566-08a69edc18a3

# --- Planday (workforce management, read-only) ---
PLANDAY_APP_ID=your-planday-client-id
PLANDAY_TOKEN=your-planday-refresh-token
# Vercel Cron auth for /api/planday/sync and /api/planday/sync-payroll
# CRON_SECRET=openssl-rand-hex-32
